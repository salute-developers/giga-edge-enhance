# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
FROM gigaedge-enhance-base AS native

# Native Python extensions need matching interpreter headers and isolated venvs.
RUN apt-get update && \
    apt-get install --no-install-recommends -y clang-format python3-dev python3-venv && \
    rm -rf /var/lib/apt/lists/*
