{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "giga-denoiser: native debug",
      "type": "shell",
      "command": "${workspaceFolder}/tools",
      "args": ["build", "native-debug-onnx", "--host"],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "giga-denoiser: native tests",
      "type": "shell",
      "command": "${workspaceFolder}/tools",
      "args": ["test", "native-debug-onnx", "--host"],
      "problemMatcher": "$gcc",
      "group": "test"
    }
  ]
}
