{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "component": "gigaedge-enhance",
      "version-file": "VERSION_NUMBER",
      "extra-files": [
        {
          "type": "json",
          "path": "web/packages/web-sdk/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web/package-lock.json",
          "jsonpath": "$.packages['packages/web-sdk'].version"
        },
        "ios/project.yml"
      ]
    }
  }
}
