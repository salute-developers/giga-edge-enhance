{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "component": "spench",
      "version-file": "SPENCH_VERSION",
      "extra-files": [
        {
          "type": "json",
          "path": "platform_wrappers/web/packages/web-sdk/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "platform_wrappers/web/package-lock.json",
          "jsonpath": "$.packages['packages/web-sdk'].version"
        },
        "platform_wrappers/ios/project.yml"
      ]
    }
  }
}
