  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "native-debug-onnx-options",
      "hidden": true,
      "cacheVariables": {
        "SPENCH_PROFILE": "native",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_ONNX_ENGINE": "ON",
        "BUILD_TFLITE_ENGINE": "OFF",
        "BUILD_TESTING": "ON",
        "BUILD_CLI": "ON"
      }
    },
    {
      "name": "native-release-onnx-options",
      "hidden": true,
      "cacheVariables": {
        "SPENCH_PROFILE": "native",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_ONNX_ENGINE": "ON",
        "BUILD_TFLITE_ENGINE": "OFF",
        "BUILD_TESTING": "ON",
        "BUILD_CLI": "ON"
      }
    },
    {
      "name": "native-release-tflite-options",
      "hidden": true,
      "cacheVariables": {
        "SPENCH_PROFILE": "native",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_ONNX_ENGINE": "OFF",
        "BUILD_TFLITE_ENGINE": "ON",
        "BUILD_TESTING": "ON",
        "BUILD_CLI": "ON"
      }
    },
    {
      "name": "native-debug-tflite-options",
      "hidden": true,
      "cacheVariables": {
        "SPENCH_PROFILE": "native",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_ONNX_ENGINE": "OFF",
        "BUILD_TFLITE_ENGINE": "ON",
        "BUILD_TESTING": "ON",
        "BUILD_CLI": "ON"
      }
    },
    {
      "name": "native-asan-onnx-options",
      "hidden": true,
      "inherits": "native-debug-onnx-options",
      "cacheVariables": {
        "BUILD_CLI": "OFF",
        "BUILD_WITH_ADDRESS_SANITIZER": "ON"
      }
    },
    {
      "name": "native-release-static-onnx-options",
      "hidden": true,
