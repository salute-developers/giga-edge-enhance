      "hidden": true,
      "inherits": "native-release-tflite-options",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "macos-x86_64-base",
      "hidden": true,
      "inherits": "macos-base",
      "cacheVariables": {
        "BUILD_APPLE_ARCH": "intel",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "macos-arm64-base",
      "hidden": true,
      "inherits": "macos-base",
      "cacheVariables": {
        "BUILD_APPLE_ARCH": "arm",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
