#!/usr/bin/env python3
"""Run supported local and containerized Spench development workflows."""

from __future__ import annotations

import argparse
import hashlib
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
DOCKERFILE = ROOT / "Dockerfile"
WEB_TEST_IMAGE_INPUTS = (
    ROOT / "platform_wrappers/web/.nvmrc",
    ROOT / "platform_wrappers/web/package.json",
    ROOT / "platform_wrappers/web/package-lock.json",
    ROOT / "platform_wrappers/web/packages/web-sdk/package.json",
    ROOT / "platform_wrappers/web/services/spench-demo/package.json",
    ROOT / "platform_wrappers/web/services/spench-demo/mos_install.sh",
    ROOT / "platform_wrappers/web/services/spench-demo/requirements-mos.txt",
)
PRESET_STAGES = {
    "native-debug-onnx": "native",
    "native-release-onnx": "native",
    "native-release-tflite": "native",
    "native-asan-onnx": "native",
    "native-model-packer": "native",
    "wasm-release": "wasm",
    "wasm-dsp-release": "wasm",
}
HOST_ONLY_PRESETS = (
    "macos-x86_64-debug-onnx",
    "macos-x86_64-release-onnx",
    "macos-x86_64-release-tflite",
    "macos-x86_64-asan-onnx",
    "macos-arm64-debug-onnx",
    "macos-arm64-release-onnx",
    "macos-arm64-release-tflite",
    "macos-arm64-asan-onnx",
    "windows-x64-debug-onnx",
    "windows-x64-release-onnx",
    "windows-x64-release-tflite",
    "windows-x64-asan-onnx",
)
CACHE_INPUTS = (
    ROOT / "package-lock.cmake",
    ROOT / "cmake/CPM.cmake",
    ROOT / "cmake/SpenchDependencies.cmake",
)
NATIVE_PRESETS = {
    "native-debug-onnx",
    "native-release-onnx",
    "native-release-tflite",
    "native-asan-onnx",
} | set(HOST_ONLY_PRESETS)


def run(command: list[str], *, container_stage: str | None = None,
        environment: dict[str, str] | None = None, workdir: Path = ROOT,
        isolate_web_node_modules: bool = False) -> None:
    if container_stage is None:
        process_environment = os.environ.copy()
        process_environment.update(environment or {})
        subprocess.run(command, cwd=workdir, check=True, env=process_environment)
        return

    if shutil.which("docker") is None:
        raise SystemExit("Docker is required for this target. Use --host for a local toolchain.")
    if subprocess.run(["docker", "info"], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        raise SystemExit("Docker is installed but its daemon is unavailable. Start Docker or use --host.")

    image_inputs = (DOCKERFILE, *WEB_TEST_IMAGE_INPUTS) if container_stage == "web-test" else (DOCKERFILE,)
    image_digest = hashlib.sha256()
    for image_input in image_inputs:
        image_digest.update(image_input.relative_to(ROOT).as_posix().encode())
        image_digest.update(image_input.read_bytes())
    image_hash = image_digest.hexdigest()[:12]
    image = f"spench-dev:{container_stage}-{image_hash}"
    if subprocess.run(["docker", "image", "inspect", image], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        subprocess.run([
            "docker", "build", "--platform", "linux/amd64", "--target", container_stage,
            "--tag", image, str(ROOT),
        ], check=True)

    cache_home = ROOT / "out" / "cache" / "container-home"
    cache_home.mkdir(parents=True, exist_ok=True)
    container_command = [
        "docker", "run", "--rm", "--init", "--platform", "linux/amd64",
        "--user", f"{os.getuid()}:{os.getgid()}",
        "--volume", f"{ROOT}:/workspace",
        "--workdir", f"/workspace/{workdir.relative_to(ROOT)}",
    ]
    if isolate_web_node_modules:
        dependency_hash = hashlib.sha256(
            (ROOT / "platform_wrappers/web/package-lock.json").read_bytes()
            + (ROOT / "platform_wrappers/web/.nvmrc").read_bytes()
        ).hexdigest()[:12]
        cache_root = ROOT / "out/cache/container-node-modules/linux-amd64" / dependency_hash
        for cache_name, container_path in (
            ("web", "/workspace/platform_wrappers/web/node_modules"),
            ("spench-demo", "/workspace/platform_wrappers/web/services/spench-demo/node_modules"),
        ):
            cache_path = cache_root / cache_name
            cache_path.mkdir(parents=True, exist_ok=True)
            container_command.extend(("--volume", f"{cache_path}:{container_path}"))
    container_command.extend((
        "--env", "HOME=/workspace/out/cache/container-home",
        "--env", "CPM_SOURCE_CACHE=/workspace/out/cache/cpm",
        "--env", "GRADLE_USER_HOME=/workspace/out/cache/gradle",
        "--env", "npm_config_cache=/workspace/out/cache/npm",
        "--env", "GIT_CONFIG_COUNT=1",
        "--env", "GIT_CONFIG_KEY_0=safe.directory",
        "--env", "GIT_CONFIG_VALUE_0=*",
    ))
    for name, value in (environment or {}).items():
        container_command.extend(("--env", f"{name}={value}"))
    container_command.extend((
        image,
        "sh",
        "-c",
        "exec \"$@\"",
        "sh",
        *command,
    ))
    subprocess.run(container_command, check=True)


def compiler_cache_environment(container: bool) -> dict[str, str]:
    cache_dir = ROOT / "out/cache/compiler"
    cache_dir.mkdir(parents=True, exist_ok=True)
    if container:
        sccache_path = "/workspace/out/cache/compiler/sccache"
        ccache_path = "/workspace/out/cache/compiler/ccache"
        source_path = "/workspace"
    else:
        sccache_path = str(cache_dir / "sccache")
        ccache_path = str(cache_dir / "ccache")
        source_path = str(ROOT)
    return {
        "SCCACHE_DIR": sccache_path,
        "SCCACHE_CACHE_SIZE": "5G",
        "CCACHE_DIR": ccache_path,
        "CCACHE_BASEDIR": source_path,
        "CCACHE_NOHASHDIR": "true",
        "CCACHE_MAXSIZE": "5G",
    }


def dependency_cache_digest() -> str:
    digest = hashlib.sha256()
    inputs = [*CACHE_INPUTS, *sorted((ROOT / "cmake/patches").glob("*.patch"))]
    for cache_input in inputs:
        digest.update(cache_input.relative_to(ROOT).as_posix().encode())
        digest.update(b"\0")
        digest.update(cache_input.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()[:16]


def cache_target(preset: str, host: bool) -> tuple[str, str]:
    if preset.startswith("macos-x86_64-"):
        return "macos", "x86_64"
    if preset.startswith("macos-arm64-"):
        return "macos", "arm64"
    if preset.startswith("windows-x64-"):
        return "windows", "x86_64"
    if preset.startswith("wasm-"):
        return "emscripten", "wasm32"
    if preset == "android":
        return "android", "multi"
    if preset == "ios":
        return "ios", "multi"
    if not host and preset in PRESET_STAGES:
        return "linux", "x86_64"

    system = platform.system().lower() or "unknown"
    machine = platform.machine().lower() or "unknown"
    architecture_aliases = {
        "amd64": "x86_64",
        "aarch64": "arm64",
    }
    return system, architecture_aliases.get(machine, machine)


def print_cache_keys(preset: str, host: bool) -> None:
    dependency_digest = dependency_cache_digest()
    target_system, target_arch = cache_target(preset, host)
    compiler_prefix = (
        f"spench-compiler-v1-{target_system}-{target_arch}-{preset}-{dependency_digest}"
    )
    print(f"source_cache_path=out/cache/cpm")
    print(f"source_cache_key=spench-sources-v1-{dependency_digest}")
    print(f"source_cache_restore_key=spench-sources-v1-")
    print(f"compiler_cache_path=out/cache/compiler")
    print(f"compiler_cache_key_prefix={compiler_prefix}")
    print(
        "compiler_cache_restore_key="
        f"spench-compiler-v1-{target_system}-{target_arch}-{preset}-"
    )


def run_web_node(command: list[str], *, container_stage: str | None,
                 environment: dict[str, str], workdir: Path) -> None:
    if container_stage is None:
        if not (Path.home() / ".nvm" / "nvm.sh").is_file():
            run(command, workdir=workdir)
            return
        nvm_script = 'source "$HOME/.nvm/nvm.sh"; nvm install; nvm use; exec "$@"'
    else:
        nvm_script = (
            'export NVM_DIR="$HOME/.nvm"; source /usr/local/lib/nvm/nvm.sh; '
            'nvm install; nvm use; exec "$@"'
        )

    run(["bash", "-lc", nvm_script, "bash", *command], container_stage=container_stage,
        environment=environment, workdir=workdir, isolate_web_node_modules=container_stage is not None)


def cmake_workflow(action: str, preset: str, host: bool) -> None:
    use_host = host or preset in HOST_ONLY_PRESETS
    stage = None if use_host else PRESET_STAGES[preset]
    build_dir = None if use_host else f"/workspace/out/build/container-clang-llvm-tools/{preset}"
    environment = compiler_cache_environment(stage is not None)
    if build_dir is not None:
        environment["SPENCH_BUILD_DIR"] = build_dir
    configure_command = ["cmake", "--preset", preset]
    build_command = ["cmake", "--build", "--preset", preset]
    if build_dir is not None:
        configure_command.extend(("-B", build_dir))
        if stage in {"native", "wasm"} and preset != "native-model-packer":
            configure_command.extend(("-Donnxruntime_USE_PREINSTALLED_EIGEN=ON",
                                      "-Deigen_SOURCE_PATH=/opt/eigen",
                                      "-DCMAKE_AR=/usr/bin/llvm-ar",
                                      "-DCMAKE_RANLIB=/usr/bin/llvm-ranlib"))
        build_command = ["cmake", "--build", build_dir]

    run(configure_command, container_stage=stage, environment=environment)
    run(build_command, container_stage=stage, environment=environment)
    if action == "test":
        if preset in NATIVE_PRESETS:
            test_command = ["ctest", "--preset", preset]
            if build_dir is not None:
                test_command = ["ctest", "--test-dir", build_dir, "--output-on-failure"]
            run(test_command, container_stage=stage, environment=environment)
        else:
            run(["bash", "platform_wrappers/web/packages/web-sdk/wasm/scripts/test.sh", preset],
                container_stage=stage, environment=environment)
    elif action == "package":
        if preset not in {"native-release-onnx", "native-release-tflite"}:
            raise SystemExit(f"Packaging is not supported for {preset}.")
        package_dir = ROOT / "out" / "artifacts" / preset
        package_dir.mkdir(parents=True, exist_ok=True)
        package_output_dir = str(package_dir) if stage is None else f"/workspace/out/artifacts/{preset}"
        package_command = ["cpack", "--preset", preset, "-B", package_output_dir]
        if build_dir is not None:
            package_command = [
                "cpack", "--config", f"{build_dir}/CPackConfig.cmake",
                "-B", package_output_dir,
            ]
        run(package_command, container_stage=stage, environment=environment)


def android_workflow(action: str, host: bool) -> None:
    stage = None if host else "android"
    script = "test-all.sh" if action == "test" else "build.sh"
    environment = compiler_cache_environment(stage is not None)
    if not host:
        environment.update({
            "SPENCH_ANDROID_NATIVE_BUILD_DIR": "/workspace/out/build/container-android-native-tests",
            "GRADLE_OPTS": "-Dorg.gradle.vfs.watch=false",
        })
    run([f"platform_wrappers/android/scripts/{script}"], container_stage=stage,
        environment=environment)


def ios_workflow(action: str) -> None:
    scripts = {
        "build": "build_xcframework.sh",
        "test": "test.sh",
        "core": "build_core.sh",
    }
    run([f"platform_wrappers/ios/scripts/{scripts[action]}"],
        environment=compiler_cache_environment(False))


def web_workflow(action: str, host: bool) -> None:
    stage = None if host else "wasm"
    web_dir = ROOT / "platform_wrappers/web"
    build_dir = None if host else "/workspace/out/build/container-clang-llvm-tools/wasm-release"
    environment = compiler_cache_environment(stage is not None)
    if build_dir is not None:
        environment["SPENCH_BUILD_DIR"] = build_dir
    run_web_node(["npm", "ci"], container_stage=stage, environment=environment, workdir=web_dir)
    configure_command = ["cmake", "--preset", "wasm-release"]
    build_command = ["cmake", "--build", "out/build/wasm-release"]
    if build_dir is not None:
        configure_command.extend((
            "-B", build_dir,
            "-Donnxruntime_USE_PREINSTALLED_EIGEN=ON",
            "-Deigen_SOURCE_PATH=/opt/eigen",
            "-DCMAKE_AR=/usr/bin/llvm-ar",
            "-DCMAKE_RANLIB=/usr/bin/llvm-ranlib",
        ))
        build_command = ["cmake", "--build", build_dir]

    run(configure_command, container_stage=stage, environment=environment)
    run(build_command, container_stage=stage, environment=environment)

    dsp_build_dir = None if host else "/workspace/out/build/container-clang-llvm-tools/wasm-dsp-release"
    dsp_environment = compiler_cache_environment(stage is not None)
    if dsp_build_dir is not None:
        dsp_environment["SPENCH_BUILD_DIR"] = dsp_build_dir
    dsp_configure_command = ["cmake", "--preset", "wasm-dsp-release"]
    dsp_build_command = ["cmake", "--build", "out/build/wasm-dsp-release"]
    if dsp_build_dir is not None:
        dsp_configure_command.extend((
            "-B", dsp_build_dir,
            "-Donnxruntime_USE_PREINSTALLED_EIGEN=ON",
            "-Deigen_SOURCE_PATH=/opt/eigen",
            "-DCMAKE_AR=/usr/bin/llvm-ar",
            "-DCMAKE_RANLIB=/usr/bin/llvm-ranlib",
        ))
        dsp_build_command = ["cmake", "--build", dsp_build_dir]

    run(dsp_configure_command, container_stage=stage, environment=dsp_environment)
    run(dsp_build_command, container_stage=stage, environment=dsp_environment)

    stage_environment = {
        "SPENCH_WASM_FULL_BUILD_DIR": build_dir or str(ROOT / "out/build/wasm-release"),
        "SPENCH_WASM_DSP_BUILD_DIR": dsp_build_dir or str(ROOT / "out/build/wasm-dsp-release"),
    }
    run_web_node(["npm", "run", "stage:wasm:release"], container_stage=stage,
                 environment=stage_environment, workdir=web_dir)
    run_web_node(["npm", "test", "--workspace=@gigaedge/spench-web-sdk"], container_stage=stage,
                 environment=environment, workdir=web_dir)
    run_web_node(["npm", "run", "build", "--workspace=@gigaedge/spench-web-sdk"], container_stage=stage,
                 environment=environment, workdir=web_dir)
    if action == "test":
        test_stage = None if host else "web-test"
        run_web_node(["npm", "run", "test:cy:mos-candidates", "--workspace=spench-demo"], container_stage=test_stage,
                     environment={"PLAYWRIGHT_WORKERS": "1"}, workdir=web_dir)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("build", "test", "package", "core", "cache-key"))
    parser.add_argument(
        "target",
        choices=(*PRESET_STAGES, *HOST_ONLY_PRESETS, "android", "ios", "web"),
        help="CMake preset or platform workflow",
    )
    parser.add_argument("--host", action="store_true",
                        help="Use locally installed tools instead of Docker where Docker is the default.")
    args = parser.parse_args()

    if args.action == "cache-key":
        print_cache_keys(args.target, args.host)
        return

    if args.target in PRESET_STAGES or args.target in HOST_ONLY_PRESETS:
        if args.action == "core":
            raise SystemExit("The core action is only valid for the iOS workflow.")
        cmake_workflow(args.action, args.target, args.host)
    elif args.target == "android":
        if args.action not in {"build", "test"}:
            raise SystemExit("Android supports build and test.")
        android_workflow(args.action, args.host)
    elif args.target == "ios":
        if args.action not in {"build", "test", "core"}:
            raise SystemExit("iOS supports build, core, and test.")
        ios_workflow(args.action)
    elif args.target == "web":
        if args.action not in {"build", "test"}:
            raise SystemExit("The web SDK supports build and test.")
        web_workflow(args.action, args.host)


if __name__ == "__main__":
    main()
