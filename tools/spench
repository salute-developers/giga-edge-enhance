def recipe_key() -> str:
    """Return the stable toolchain-compiler identity shared by every image stage.

    All native, Web, and Android stages compile with the same multi-stage
    Dockerfile, so its content hash is the identity that a compiled dependency
    bundle depends on. Unlike the buildx image digest, it is reproducible across
    runs, branches, and pull requests, so restored dependency OCI artifacts stay
    valid as long as the Dockerfile is unchanged.
    """
    return hashlib.sha256(DOCKERFILE.read_bytes()).hexdigest()[:16]


def playwright_version() -> str:
    """Resolve the Playwright version baked into the Web image from the lockfile."""
    lock = json.loads(WEB_PACKAGE_LOCK.read_text())
    entry = lock.get("packages", {}).get("node_modules/playwright", {})
    version = entry.get("version")
    if not version:
        raise SystemExit("Could not resolve the Playwright version from package-lock.json.")
    return version


def container_image_digest(container_stage: str) -> str:
    """Return the content-derived tag for a toolchain or dependency image stage."""
    image_digest = hashlib.sha256()
    image_digest.update(DOCKERFILE.relative_to(ROOT).as_posix().encode())
    image_digest.update(DOCKERFILE.read_bytes())
    if container_stage == "web":
        # The Web image additionally bakes Node, the MOS venv, and a pinned
        # Playwright Chromium; fold exactly those inputs so the tag tracks real
        # image containment rather than unrelated Web SDK source changes.
        for image_input in WEB_IMAGE_INPUTS:
            image_digest.update(image_input.relative_to(ROOT).as_posix().encode())
            image_digest.update(image_input.read_bytes())
        image_digest.update(b"playwright=")
        image_digest.update(playwright_version().encode())
    dependency_root = ROOT / "out" / "artifacts" / "dependencies"
    dependency_stage_system = {
        "deps-native": "linux",
        "deps-wasm": "emscripten",
        "deps-android": "android",
        "deps-ios": "ios",
        "deps-macos-x86_64": "macos",
        "deps-macos-arm64": "macos",
        "deps-windows-x64": "windows",
    }
    if container_stage in dependency_stage_system:
        stage_system = dependency_stage_system[container_stage]
        for manifest in sorted(dependency_root.rglob("manifest.json")):
            relative_parts = manifest.relative_to(dependency_root).parts
            if relative_parts[0] != stage_system:
                continue
            if container_stage == "deps-macos-x86_64" and relative_parts[1] != "x86_64":
                continue
            if container_stage == "deps-macos-arm64" and relative_parts[1] != "arm64":
                continue
            if container_stage == "deps-windows-x64" and relative_parts[1] != "x86_64":
                continue
            image_digest.update(manifest.relative_to(ROOT).as_posix().encode())
            image_digest.update(manifest.read_bytes())
    return image_digest.hexdigest()[:16]


def container_image_name(container_stage: str) -> str:
    """Return the immutable local image name for a toolchain or dependency stage."""
    return f"spench-dev:{container_stage}-{container_image_digest(container_stage)}"


def ensure_container_image(container_stage: str) -> str:
    """Build a stage only when its Dockerfile inputs or dependency bundles changed."""
    if shutil.which("docker") is None:
        raise SystemExit("Docker is required for this target. Use --host for a local toolchain.")
    if subprocess.run(["docker", "info"], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        raise SystemExit("Docker is installed but its daemon is unavailable. Start Docker or use --host.")

    image = container_image_name(container_stage)
    if subprocess.run(["docker", "image", "inspect", image], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        return image

    remote_image = os.environ.get(
        f"SPENCH_CONTAINER_IMAGE_{container_stage.upper().replace('-', '_')}")
    if remote_image:
        print(f"Restoring {container_stage} toolchain image: {remote_image}")
        if subprocess.run(["docker", "pull", remote_image]).returncode == 0:
            subprocess.run(["docker", "tag", remote_image, image], check=True)
            return image
        print("Remote toolchain image is unavailable; building it locally.")

    build_command = [
        "docker", "build", "--platform", "linux/amd64", "--target", container_stage,
        "--tag", image,
    ]
    if container_stage.startswith("deps-"):
        dependency_root = ROOT / "out" / "artifacts" / "dependencies"
        dependency_root.mkdir(parents=True, exist_ok=True)
        build_command.extend(("--build-context", f"spench_deps={dependency_root}"))
    build_command.append(str(ROOT))
    subprocess.run(build_command, check=True)
    return image


def run(command: list[str], *, container_stage: str | None = None,
        environment: dict[str, str] | None = None, workdir: Path = ROOT,
        isolate_web_node_modules: bool = False) -> None:
    if container_stage is None:
        process_environment = os.environ.copy()
        process_environment.update(environment or {})
        add_github_git_auth(process_environment)
        subprocess.run(command, cwd=workdir, check=True, env=process_environment)
        return

    image = ensure_container_image(container_stage)

    cache_home = ROOT / "out" / "cache" / "container-home"
    cache_home.mkdir(parents=True, exist_ok=True)
    container_command = [
        "docker", "run", "--rm", "--init", "--platform", "linux/amd64",
        "--user", f"{os.getuid()}:{os.getgid()}",
        "--volume", f"{ROOT}:/workspace",
        "--workdir", f"/workspace/{workdir.relative_to(ROOT)}",
    ]
    if isolate_web_node_modules:
        dependency_hash = hashlib.sha256(
            (ROOT / "platform_wrappers/web/package-lock.json").read_bytes()
            + (ROOT / "platform_wrappers/web/.nvmrc").read_bytes()
        ).hexdigest()[:12]
        cache_root = ROOT / "out/cache/container-node-modules/linux-amd64" / dependency_hash
        for cache_name, container_path in (
            ("web", "/workspace/platform_wrappers/web/node_modules"),
            ("spench-site", "/workspace/platform_wrappers/web/apps/spench-site/node_modules"),
        ):
            cache_path = cache_root / cache_name
            cache_path.mkdir(parents=True, exist_ok=True)
            container_command.extend(("--volume", f"{cache_path}:{container_path}"))
    container_command.extend((
        "--env", "HOME=/workspace/out/cache/container-home",
        "--env", "GRADLE_USER_HOME=/workspace/out/cache/gradle",
        "--env", "npm_config_cache=/workspace/out/cache/npm",
    ))
    for name, value in (environment or {}).items():
        container_command.extend(("--env", f"{name}={value}"))
    container_git_environment = {
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": "safe.directory",
        "GIT_CONFIG_VALUE_0": "*",
    }
    if header := os.environ.get("SPENCH_GITHUB_AUTH_HEADER"):
        container_git_environment["SPENCH_GITHUB_AUTH_HEADER"] = header
    add_github_git_auth(container_git_environment)
    container_environment = os.environ.copy()
    container_environment.pop("SPENCH_GITHUB_AUTH_HEADER", None)
    container_environment.update(container_git_environment)
    for name in sorted(container_git_environment):
        container_command.extend(("--env", name))
    container_command.extend((
        image,
        "sh",
        "-c",
        "exec \"$@\"",
        "sh",
        *command,
    ))
    subprocess.run(container_command, check=True, env=container_environment)


def add_github_git_auth(environment: dict[str, str]) -> None:
    """Add ephemeral GitHub HTTPS authentication without persisting credentials."""
    header = environment.pop("SPENCH_GITHUB_AUTH_HEADER", "")
    if not header:
        return
    try:
        index = int(environment.get("GIT_CONFIG_COUNT", "0"))
    except ValueError as error:
        raise SystemExit("GIT_CONFIG_COUNT must be an integer.") from error
    environment[f"GIT_CONFIG_KEY_{index}"] = "http.https://github.com/.extraheader"
    environment[f"GIT_CONFIG_VALUE_{index}"] = header
    environment["GIT_CONFIG_COUNT"] = str(index + 1)


def compiler_cache_environment(container: bool) -> dict[str, str]:
    cache_dir = ROOT / "out/cache/compiler"
    cache_dir.mkdir(parents=True, exist_ok=True)
    if container:
        sccache_path = "/workspace/out/cache/compiler/sccache"
        ccache_path = "/workspace/out/cache/compiler/ccache"
        source_path = "/workspace"
    else:
        sccache_path = str(cache_dir / "sccache")
        ccache_path = str(cache_dir / "ccache")
        source_path = str(ROOT)
    return {
        "SCCACHE_DIR": sccache_path,
        "SCCACHE_CACHE_SIZE": "5G",
        "CCACHE_DIR": ccache_path,
        "CCACHE_BASEDIR": source_path,
        "CCACHE_NOHASHDIR": "true",
        "CCACHE_MAXSIZE": "5G",
    }


def print_compiler_cache_stats(container_stage: str | None,
                               environment: dict[str, str]) -> None:
    """Show the cache counters after a build without making cache availability fatal."""
    command = ["ccache", "--show-stats"] if container_stage is not None else None
    if command is None:
        if shutil.which("sccache"):
            command = ["sccache", "--show-stats"]
        elif shutil.which("ccache"):
            command = ["ccache", "--show-stats"]
    if command is None:
        return
    print("Compiler cache statistics:")
    try:
        run(command, container_stage=container_stage, environment=environment)
    except subprocess.CalledProcessError:
        print("Compiler cache statistics are unavailable for this build.")


def dependency_cache_digest() -> str:
    digest = hashlib.sha256()
    inputs = [*CACHE_INPUTS, *sorted((ROOT / "cmake/patches").glob("*.patch"))]
    for cache_input in inputs:
        digest.update(cache_input.relative_to(ROOT).as_posix().encode())
        digest.update(b"\0")
        digest.update(cache_input.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()[:16]


def engine_git_tag(engine: str) -> str:
    """Return the pinned upstream tag for an engine from package-lock.cmake."""
    try:
        package = ENGINE_PACKAGE[engine]
    except KeyError as error:
        raise ValueError(f"Unsupported dependency bundle engine: {engine}") from error
    lock_text = (ROOT / "package-lock.cmake").read_text()
    declaration = re.search(
        rf"CPMDeclarePackage\({re.escape(package)}\s.*?\n\)",
        lock_text,
        flags=re.DOTALL,
    )
    if declaration is None:
        raise SystemExit(f"Could not find the {engine} declaration in package-lock.cmake.")
    tag = re.search(r'GIT_TAG\s+"?([^"\s]+)"?', declaration.group(0))
    if tag is None:
        raise SystemExit(f"Could not find GIT_TAG for {engine} in package-lock.cmake.")
    return tag.group(1)


def dependency_bundle_digest(engine: str) -> str:
    """Return the identity of an engine's compiled binary bundle.

    Only dependency-facing recipes are included so expensive bundles survive
    unrelated application edits while still rebuilding when their graph changes.
    """
    if engine not in ENGINE_PATCH:
        raise ValueError(f"Unsupported dependency bundle engine: {engine}")
    digest = hashlib.sha256()
    digest.update(f"format={DEPENDENCY_BUNDLE_FORMAT}".encode())
    digest.update(b"\0")
    # Compiled engine bundles are tied to the toolchain that produced them.
    # CI passes the immutable toolchain recipe identity; local builds use an
    # explicit host marker so their artifacts cannot be mistaken for CI products.
    digest.update(os.environ.get("SPENCH_TOOLCHAIN_IDENTITY", "local-host").encode())
    digest.update(b"\0")
    digest.update(engine.encode())
    digest.update(b"\0")
    digest.update(engine_git_tag(engine).encode())
    digest.update(b"\0")
    digest.update(hashlib.sha256(ENGINE_PATCH[engine].read_bytes()).hexdigest().encode())
    digest.update(b"\0")
    for recipe in DEPENDENCY_RECIPE_INPUTS:
        digest.update(recipe.relative_to(ROOT).as_posix().encode())
        digest.update(b"\0")
        digest.update(recipe.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()[:16]


def dependency_tag(preset: str, host: bool) -> str:
    """Return a stable GHCR tag for one concrete dependency bundle."""
    requirement = engine_requirement(preset)
    if requirement is None:
        raise SystemExit(f"{preset} does not use a prebuilt engine dependency.")
    engine, build_type = requirement
    target_system, target_arch = cache_target(preset, host)
    # <engine>-<platform>-<arch>-<build>-<linkage>-<digest>. The bundle format
    # is already folded into the digest, so it needs no separate tag segment.
    parts = (
        engine,
        target_system,
        target_arch,
        build_type.lower(),
        bundle_linkage(preset),
        dependency_bundle_digest(engine),
    )
    return "-".join(parts).replace("_", "-").lower()


def cache_target(preset: str, host: bool) -> tuple[str, str]:
    if preset in ANDROID_DEPENDENCY_TARGETS:
        return "android", ANDROID_DEPENDENCY_TARGETS[preset]
    if preset.startswith("macos-x86_64-"):
        return "macos", "x86_64"
    if preset.startswith("macos-arm64-"):
        return "macos", "arm64"
    if preset.startswith("windows-x64-"):
        return "windows", "x86_64"
    if preset.startswith("wasm-"):
        return "emscripten", "wasm32"
    if preset.startswith("ios-device-"):
        return "ios", "arm64"
    if preset.startswith("ios-simulator-"):
        return "ios", "arm64-x86_64"
    if preset == "android":
        return "android", "multi"
    if preset == "ios":
        return "ios", "multi"
    if not host and preset in PRESET_STAGES:
        return "linux", "x86_64"

    system = platform.system().lower() or "unknown"
    machine = platform.machine().lower() or "unknown"
    architecture_aliases = {
        "amd64": "x86_64",
        "aarch64": "arm64",
    }
    return system, architecture_aliases.get(machine, machine)


def print_cache_keys(preset: str, host: bool) -> None:
    dependency_digest = dependency_cache_digest()
    target_system, target_arch = cache_target(preset, host)
    compiler_prefix = (
        f"spench-compiler-v1-{target_system}-{target_arch}-{preset}-{dependency_digest}"
    )
    print(f"source_cache_path=out/cache/cpm")
    print(f"source_cache_key=spench-sources-v1-{dependency_digest}")
    print(f"source_cache_restore_key=spench-sources-v1-")
    print(f"compiler_cache_path=out/cache/compiler")
    print(f"compiler_cache_key_prefix={compiler_prefix}")
    print(
        "compiler_cache_restore_key="
        f"spench-compiler-v1-{target_system}-{target_arch}-{preset}-"
    )


def engine_requirement(preset: str) -> tuple[str, str] | None:
    """Return the engine and dependency build type required by a preset."""
    if preset in ANDROID_DEPENDENCY_TARGETS:
        return "tflite", "Release"
    if preset in {"native-model-packer", "wasm-dsp-release", "wasm-dsp-debug"}:
        return None
    if "tflite" in preset:
        return "tflite", "Debug" if "debug" in preset else "Release"
    if "onnx" in preset or preset.startswith(("wasm-", "ios-")):
        return "onnx", "Debug" if "debug" in preset or "asan" in preset else "Release"
    return None


def bundle_linkage(preset: str) -> str:
    if preset.startswith(("wasm-", "ios-")):
        return "static"
    return "static" if "-static-" in preset else "shared"


def artifact_preset(preset: str) -> str:
    """ASAN consumes the matching non-instrumented Debug engine bundle."""
    return preset.replace("asan", "debug")


def dependency_artifact_root(preset: str, host: bool) -> Path | None:
    requirement = engine_requirement(preset)
    if requirement is None:
        return None
    engine, build_type = requirement
    target_system, target_arch = cache_target(preset, host)
    identity = f"v{DEPENDENCY_BUNDLE_FORMAT}-{dependency_bundle_digest(engine)}"
    return (ROOT / "out" / "artifacts" / "dependencies" / target_system /
            target_arch / engine / build_type.lower() / bundle_linkage(preset) / identity)


def dependency_artifact_for_target(target: str, host: bool) -> Path:
    if target in ANDROID_DEPENDENCY_TARGETS:
        abi = ANDROID_DEPENDENCY_TARGETS[target]
        identity = f"v{DEPENDENCY_BUNDLE_FORMAT}-{dependency_bundle_digest('tflite')}"
        return (ROOT / "out" / "artifacts" / "dependencies" / "android" / abi /
                "tflite" / "release" / "shared" / identity)
    artifact_root = dependency_artifact_root(target, host)
    if artifact_root is None:
        raise SystemExit(f"{target} does not produce a dependency bundle.")
    return artifact_root


def dependency_archive_for_target(target: str, host: bool) -> Path:
    return Path(f"{dependency_artifact_for_target(target, host)}.tar.gz")


def executable_version(command: str) -> str:
    executable = shutil.which(command)
    if executable is None:
        return "not-found"
    result = subprocess.run([executable, "--version"], text=True, capture_output=True,
                            check=False)
    return result.stdout.splitlines()[0] if result.stdout else executable


def dependency_manifest(preset: str, host: bool, prefix: Path) -> dict[str, object]:
    engine, build_type = engine_requirement(preset) or ("none", "None")
    target_system, target_arch = cache_target(preset, host)
    return {
        "format": DEPENDENCY_BUNDLE_FORMAT,
        "engine": engine,
        "build_type": build_type,
        "linkage": bundle_linkage(preset),
        "preset": artifact_preset(preset),
        "target_system": target_system,
        "target_architecture": target_arch,
        "dependency_digest": dependency_bundle_digest(engine),
        "toolchain_identity": os.environ.get("SPENCH_TOOLCHAIN_IDENTITY", "local-host"),
        "prefix": str(prefix.relative_to(ROOT)),
    }


def copy_onnx_headers(prefix: Path) -> None:
    source_roots = sorted((ROOT / "out" / "cache" / "cpm" / "onnxruntime").glob("*/include"))
    if not source_roots:
        raise SystemExit("ONNX Runtime source headers were not found in out/cache/cpm after CPM preparation.")
    destination = prefix / "include" / "onnxruntime"
    shutil.copytree(source_roots[-1] / "onnxruntime", destination, dirs_exist_ok=True)


def copy_header_tree(source: Path, destination: Path) -> None:
    """Copy compiler-consumed headers without packaging dependency sources."""
    header_suffixes = {".h", ".hh", ".hpp", ".inc"}
    copied = 0
    for path in source.rglob("*"):
        if not path.is_file() or path.suffix not in header_suffixes:
            continue
        output = destination / path.relative_to(source)
        output.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, output)
        copied += 1
    if copied == 0:
        raise SystemExit(f"No public headers were found below {source}.")
    print(f"Copied {copied} public headers from {source}.")


def copy_tflite_headers(prefix: Path, build_dir: Path | None = None) -> None:
    """Copy TFLite's public headers and its header-only public dependencies."""
    source_roots = []
    if build_dir is not None:
        source_roots.extend((build_dir / "_deps").glob("tflite-src/tensorflow"))
    source_roots.extend((ROOT / "out" / "cache" / "cpm" / "tflite").glob("*/tensorflow"))
    source_roots = sorted(set(source_roots))
    if not source_roots:
        raise SystemExit("TensorFlow Lite headers were not found after CPM preparation.")
    copy_header_tree(source_roots[-1] / "lite", prefix / "include" / "tensorflow" / "lite")
    if build_dir is None:
        return

    header_dependencies = {
        "flatbuffers": ("flatbuffers.h", 0),
        "absl": ("config.h", 1),
    }
    for directory, (header, parents) in header_dependencies.items():
        candidates = sorted(build_dir.rglob(f"{directory}/**/{header}"))
        if not candidates:
            raise SystemExit(
                f"TensorFlow Lite preparation did not produce public {directory} headers below {build_dir}.")
        source = candidates[0]
        for _ in range(parents):
            source = source.parent
        source = source.parent
        copy_header_tree(source, prefix / "include" / directory)


def copy_static_archives(prefix: Path, build_dir: Path) -> list[Path]:
    """Copy archives without merging them, so duplicate object names remain distinct."""
    archive_root = prefix / "lib" / "archives"
    # The build root is dedicated to dependency preparation, so every produced
    # archive belongs to the bundle. Filtering absolute path components is wrong:
    # GitHub's checkout path itself contains a directory named "spench".
    archives = sorted({archive for pattern in ("*.a", "*.lib")
                       for archive in build_dir.rglob(pattern)})
    if not archives:
        raise SystemExit(f"No static archives were produced below {build_dir}.")

    copied = []
    for archive in archives:
        # Keeping the build-relative path avoids collisions such as the many
        # independently-built det.cc.o members found in ONNX Runtime archives.
        destination = archive_root / archive.relative_to(build_dir)
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(archive, destination)
        copied.append(destination)
    return copied


def copy_engine_library(prefix: Path, engine: str, build_dir: Path) -> Path:
    """Copy a shared engine library, loader aliases, and Windows import library."""
    library_dir = prefix / "lib"
    library_dir.mkdir(parents=True, exist_ok=True)
    stem = "onnxruntime" if engine == "onnx" else "tensorflow-lite"
    candidates = sorted({
        *build_dir.rglob(f"lib{stem}*.dylib"),
        *build_dir.rglob(f"lib{stem}*.so"),
        *build_dir.rglob(f"lib{stem}*.so.*"),
        *build_dir.rglob(f"{stem}*.dll"),
    })
    if not candidates:
        raise SystemExit(f"No shared {engine} library was produced below {build_dir}.")
    # Preserve the loader aliases as regular files.  CMake can emit either
    # -l<name> or the library SONAME for a transitive static consumer.
    for source in candidates:
        shutil.copy2(source, library_dir / source.name)
    if any(candidate.suffix == ".dll" for candidate in candidates):
        import_libraries = sorted(build_dir.rglob(f"{stem}*.lib"))
        if not import_libraries:
            raise SystemExit(f"No import library was produced for shared {engine} below {build_dir}.")
        for source in import_libraries:
            shutil.copy2(source, library_dir / source.name)
    return library_dir / candidates[0].name


def write_engine_package_config(prefix: Path, engine: str, library: Path | None, linkage: str,
                                target_name: str | None = None,
                                static_archives: list[Path] | None = None) -> None:
    """Write a relocatable config independent of upstream engine dependencies."""
    package = "onnxruntime" if engine == "onnx" else "tensorflow-lite"
    target = target_name or ("onnxruntime::onnxruntime" if engine == "onnx"
                             else "tensorflow-lite::tensorflow-lite")
    config_dir = prefix / "lib" / "cmake" / package
    config_dir.mkdir(parents=True, exist_ok=True)
    prefix_variable = "_spench_ort_prefix" if engine == "onnx" else "_spench_tflite_prefix"
    if linkage == "static":
        if not static_archives:
            raise ValueError("Static engine package configuration requires copied archives.")
        archive_paths = [archive.relative_to(prefix).as_posix() for archive in static_archives]
        archive_entries = "\n".join(
            f"  \"${{{prefix_variable}}}/{archive}\"" for archive in archive_paths)
        # GNU ld needs a rescan group for ONNX Runtime's cyclic static archives.
        # Apple and MSVC linkers resolve the regular archive list themselves.
        config = (
            "include(CMakeFindDependencyMacro)\n"
            f"get_filename_component({prefix_variable} \"${{CMAKE_CURRENT_LIST_DIR}}/../../..\" ABSOLUTE)\n"
            "find_dependency(Threads)\n"
            f"set(_spench_engine_archives\n{archive_entries}\n)\n"
            "if(CMAKE_SYSTEM_NAME STREQUAL \"Linux\")\n"
            "  string(JOIN \",\" _spench_engine_archive_group ${_spench_engine_archives})\n"
            "  set(_spench_engine_link_libraries \"$<LINK_GROUP:RESCAN,${_spench_engine_archive_group}>\")\n"
            "else()\n"
            "  set(_spench_engine_link_libraries \"${_spench_engine_archives}\")\n"
            "endif()\n"
            f"if(NOT TARGET {target})\n"
            f"  add_library({target} INTERFACE IMPORTED GLOBAL)\n"
            f"  set_target_properties({target} PROPERTIES\n"
            f"    INTERFACE_INCLUDE_DIRECTORIES \"${{{prefix_variable}}}/include\"\n"
            "    INTERFACE_LINK_LIBRARIES \"${_spench_engine_link_libraries};Threads::Threads;${CMAKE_DL_LIBS};m\"\n"
            "  )\n"
            "endif()\n")
    else:
        if library is None:
            raise ValueError("Shared engine package configuration requires its shared library.")
        import_library = prefix / "lib" / f"{library.stem}.lib"
        imported_implib = (
            f"    IMPORTED_IMPLIB \"${{{prefix_variable}}}/lib/{import_library.name}\"\n"
            if library.suffix == ".dll" and import_library.is_file() else "")
        config = (
            "include(CMakeFindDependencyMacro)\n"
            f"get_filename_component({prefix_variable} \"${{CMAKE_CURRENT_LIST_DIR}}/../../..\" ABSOLUTE)\n"
            f"if(NOT TARGET {target})\n"
            f"  add_library({target} SHARED IMPORTED GLOBAL)\n"
            f"  set_target_properties({target} PROPERTIES\n"
            f"    IMPORTED_LOCATION \"${{{prefix_variable}}}/lib/{library.name}\"\n"
            f"{imported_implib}"
            f"    INTERFACE_INCLUDE_DIRECTORIES \"${{{prefix_variable}}}/include\"\n"
            "  )\n"
            "endif()\n")
    (config_dir / f"{package}Config.cmake").write_text(config)


@contextlib.contextmanager
def artifact_lock(artifact_root: Path):
    """Prevent two invocations from configuring the same nested engine sources."""
    lock_path = artifact_root.with_name(f"{artifact_root.name}.lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        descriptor = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError as error:
        raise SystemExit(
            f"Dependency preparation is already running for {artifact_root.relative_to(ROOT)}. "
            f"Wait for it to finish before retrying.") from error
    try:
        os.write(descriptor, f"pid={os.getpid()}\n".encode())
        yield
    finally:
        os.close(descriptor)
        lock_path.unlink(missing_ok=True)


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def write_artifact_checksums(artifact_root: Path) -> None:
    """Write deterministic SHA-256 entries for every deliberate artifact file."""
    checksum_path = artifact_root / "checksums.sha256"
    files = sorted(path for path in artifact_root.rglob("*")
                   if path.is_file() and path != checksum_path)
    checksum_path.write_text("".join(
        f"{file_sha256(path)}  {path.relative_to(artifact_root).as_posix()}\n"
        for path in files))


def write_dependency_bundle(artifact_root: Path, manifest: dict[str, object]) -> None:
    artifact_root.mkdir(parents=True, exist_ok=True)
    (artifact_root / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    archive = Path(shutil.make_archive(str(artifact_root), "gztar", root_dir=artifact_root))
    archive_digest = file_sha256(archive)
    archive.with_suffix(archive.suffix + ".sha256").write_text(
        f"{archive_digest}  {archive.name}\n")


def restore_dependency_bundle(target: str, host: bool, archive: Path) -> None:
    """Verify and restore a dependency archive pulled from the OCI registry."""
    archive = archive.resolve()
    checksum_path = Path(f"{archive}.sha256")
    if not archive.is_file() or not checksum_path.is_file():
        raise SystemExit(f"Dependency archive or checksum is missing: {archive}")
    expected_checksum = checksum_path.read_text().split()[0]
    actual_checksum = file_sha256(archive)
    if actual_checksum != expected_checksum:
        raise SystemExit(
            f"Dependency checksum mismatch for {archive.name}: "
            f"expected {expected_checksum}, got {actual_checksum}.")

    artifact_root = dependency_artifact_for_target(target, host)
    artifact_root.mkdir(parents=True, exist_ok=True)
    root = artifact_root.resolve()
    with tarfile.open(archive, "r:gz") as bundle:
        members = bundle.getmembers()
        for member in members:
            destination = (root / member.name).resolve()
            if destination != root and root not in destination.parents:
                raise SystemExit(f"Unsafe path in dependency archive: {member.name}")
            if member.issym() or member.islnk():
                raise SystemExit(f"Links are not allowed in dependency archive: {member.name}")
        bundle.extractall(root, members=members)

    manifest_path = artifact_root / "manifest.json"
    prefix = artifact_root / "prefix"
    if not manifest_path.is_file() or not prefix.is_dir():
        raise SystemExit(f"Restored dependency bundle is incomplete: {artifact_root}")
    manifest = json.loads(manifest_path.read_text())
    engine = str(manifest.get("engine"))
    if manifest.get("dependency_digest") != dependency_bundle_digest(engine):
        raise SystemExit(f"Restored dependency manifest does not match {target}.")
    requirement = engine_requirement(target)
    target_system, target_arch = cache_target(target, host)
    expected = {
        "engine": requirement[0] if requirement else None,
        "build_type": requirement[1] if requirement else None,
        "linkage": bundle_linkage(target),
        "target_system": target_system,
        "target_architecture": target_arch,
        "toolchain_identity": os.environ.get("SPENCH_TOOLCHAIN_IDENTITY", "local-host"),
    }
    mismatches = {
        key: (manifest.get(key), value)
        for key, value in expected.items()
        if manifest.get(key) != value
    }
    if mismatches:
        raise SystemExit(f"Restored dependency manifest has incompatible fields: {mismatches}")
    print(f"Restored dependency bundle: {artifact_root.relative_to(ROOT)}")


def write_tflite_package_config(prefix: Path) -> None:
    """Replace TFLite's non-relocatable dependency config with a bundle config."""
    candidates = sorted({
        *prefix.glob("lib/libtensorflow-lite*.a"),
        *prefix.glob("lib/libtensorflow-lite*.dylib"),
        *prefix.glob("lib/libtensorflow-lite*.so"),
        *prefix.glob("lib/libtensorflow-lite*.so.*"),
        *prefix.glob("lib/tensorflow-lite*.lib"),
    })
    if len(candidates) != 1:
        raise SystemExit(
            f"Expected exactly one installed TensorFlow Lite library under {prefix / 'lib'}, "
            f"found {len(candidates)}.")
    library_name = candidates[0].name
    config_dir = prefix / "lib" / "cmake" / "tensorflow-lite"
    config_dir.mkdir(parents=True, exist_ok=True)
    (config_dir / "tensorflow-liteConfig.cmake").write_text(
        "get_filename_component(_spench_tflite_prefix \"${CMAKE_CURRENT_LIST_DIR}/../../..\" ABSOLUTE)\n"
        "if(NOT TARGET tensorflow-lite::tensorflow-lite)\n"
        "  add_library(tensorflow-lite::tensorflow-lite UNKNOWN IMPORTED)\n"
        "  set_target_properties(tensorflow-lite::tensorflow-lite PROPERTIES\n"
        f"    IMPORTED_LOCATION \"${{_spench_tflite_prefix}}/lib/{library_name}\"\n"
        "    INTERFACE_INCLUDE_DIRECTORIES \"${_spench_tflite_prefix}/include\")\n"
        "endif()\n")


def write_wasm_onnx_package_config(prefix: Path, build_dir: Path) -> None:
    """Export ORT's manually bundled Emscripten archive as an imported target."""
    candidates = sorted(build_dir.rglob("libonnxruntime_webassembly.a"))
    if len(candidates) != 1:
        raise SystemExit(
            f"Expected exactly one WebAssembly ONNX Runtime archive below {build_dir}, "
            f"found {len(candidates)}.")
    library_dir = prefix / "lib"
    library_dir.mkdir(parents=True, exist_ok=True)
    library_name = candidates[0].name
    shutil.copy2(candidates[0], library_dir / library_name)
    config_dir = library_dir / "cmake" / "onnxruntime"
    config_dir.mkdir(parents=True, exist_ok=True)
    (config_dir / "onnxruntimeConfig.cmake").write_text(
        "get_filename_component(_spench_ort_prefix \"${CMAKE_CURRENT_LIST_DIR}/../../..\" ABSOLUTE)\n"
        "if(NOT TARGET onnxruntime_webassembly)\n"
        "  add_library(onnxruntime_webassembly STATIC IMPORTED GLOBAL)\n"
        "  set_target_properties(onnxruntime_webassembly PROPERTIES\n"
        f"    IMPORTED_LOCATION \"${{_spench_ort_prefix}}/lib/{library_name}\"\n"
        "    INTERFACE_INCLUDE_DIRECTORIES \"${_spench_ort_prefix}/include\")\n"
        "endif()\n")


def prepare_dependency(preset: str, host: bool) -> Path | None:
    """Build the normal CMake graph's selected engine target and export a bundle."""
    requirement = engine_requirement(preset)
    artifact_root = dependency_artifact_root(preset, host)
    if requirement is None or artifact_root is None:
        return None
    engine, build_type = requirement
    prefix = artifact_root / "prefix"
    manifest_path = artifact_root / "manifest.json"
    expected = dependency_manifest(preset, host, prefix)
    if manifest_path.is_file() and prefix.is_dir():
        try:
            if json.loads(manifest_path.read_text()) == expected:
                print(f"Reusing prebuilt {engine} dependency bundle: {artifact_root.relative_to(ROOT)}")
                return prefix
        except json.JSONDecodeError:
            pass

    with artifact_lock(artifact_root):
        if manifest_path.is_file() and prefix.is_dir():
            try:
                if json.loads(manifest_path.read_text()) == expected:
                    print(f"Reusing prebuilt {engine} dependency bundle: {artifact_root.relative_to(ROOT)}")
                    return prefix
            except json.JSONDecodeError:
                pass

        use_host = host or preset in HOST_ONLY_PRESETS
        stage = None if use_host else PRESET_STAGES[preset]
        container = stage is not None
        preparation_stage = f"{stage}-base" if stage in {"native", "android"} else stage
        environment = compiler_cache_environment(container)
        target_system, target_arch = cache_target(preset, host)
        linkage = bundle_linkage(preset)
        build_dir_host = (ROOT / "out" / "build" / "prebuilt" / target_system / target_arch /
                          engine / build_type.lower() / linkage)
        build_dir = (f"/workspace/{build_dir_host.relative_to(ROOT)}" if container else str(build_dir_host))
        configure_command = [
            "cmake", "--preset", artifact_preset(preset), "-B", build_dir,
            f"-DSPENCH_ENGINE_BUNDLE_LINKAGE={linkage}",
            "-DSPENCH_PREPARE_DEPENDENCY_BUNDLE=ON",
        ]
        if container and stage in {"native", "web"}:
            configure_command.extend(("-DCMAKE_AR=/usr/bin/llvm-ar",
                                      "-DCMAKE_RANLIB=/usr/bin/llvm-ranlib"))
        print(f"Preparing {engine} {build_type} dependency bundle for {target_system}/{target_arch}.")
        run(configure_command, container_stage=preparation_stage, environment=environment)
        targets = (["libonnxruntime_webassembly.a"]
                   if preset.startswith("wasm-") else ["spench_dependency_bundle"])
        build_command = ["cmake", "--build", build_dir, "--target", *targets, "--parallel"]
        # CMake accepts --config for single-config generators and requires it for
        # Xcode/MSBuild. Passing it universally keeps Release bundle jobs honest.
        build_command.extend(("--config", build_type))
        run(build_command,
            container_stage=preparation_stage, environment=environment)
        if preset.startswith("wasm-") and engine == "onnx":
            write_wasm_onnx_package_config(prefix, build_dir_host)
        else:
            if linkage == "static":
                archives = copy_static_archives(prefix, build_dir_host)
                write_engine_package_config(prefix, engine, None, linkage,
                                            static_archives=archives)
            else:
                library = copy_engine_library(prefix, engine, build_dir_host)
                write_engine_package_config(prefix, engine, library, linkage)
        if engine == "onnx":
            copy_onnx_headers(prefix)
        else:
            copy_tflite_headers(prefix, build_dir_host)

        write_dependency_bundle(artifact_root, expected)
        print(f"Prepared dependency bundle: {artifact_root.relative_to(ROOT)}")
        return prefix


def find_prebuilt_dependency(preset: str, host: bool) -> Path | None:
    """Return a local compatible bundle, or leave the build to CPM."""
    artifact_root = dependency_artifact_root(preset, host)
    if artifact_root is None:
        return None
    prefix = artifact_root / "prefix"
    manifest_path = artifact_root / "manifest.json"
    if not manifest_path.is_file() or not prefix.is_dir():
        return None
    try:
        if json.loads(manifest_path.read_text()) == dependency_manifest(preset, host, prefix):
            print(f"Using prebuilt dependency bundle: {artifact_root.relative_to(ROOT)}")
            return prefix
    except json.JSONDecodeError:
        pass
    print(f"Ignoring incompatible dependency bundle: {artifact_root.relative_to(ROOT)}")
    return None


def prebuilt_cmake_arguments(preset: str, host: bool, prefix: Path | None,
                             container: bool) -> list[str]:
    if prefix is None:
        return []
    requirement = engine_requirement(preset)
    if requirement is None:
        return []
    root = str(prefix)
    if container:
        root = f"/workspace/{prefix.relative_to(ROOT)}"
    variable = "SPENCH_PREBUILT_ORT_ROOT" if requirement[0] == "onnx" else "SPENCH_PREBUILT_TFLITE_ROOT"
    return [f"-D{variable}={root}"]


def prepare_android_tflite(abi: str, build_type: str, host: bool) -> Path:
    """Export one Android ABI/configuration TFLite bundle without Gradle."""
    identity = f"v{DEPENDENCY_BUNDLE_FORMAT}-{dependency_bundle_digest('tflite')}"
    artifact_root = (ROOT / "out" / "artifacts" / "dependencies" / "android" / abi /
                     "tflite" / build_type.lower() / "shared" / identity)
    prefix = artifact_root / "prefix"
    manifest_path = artifact_root / "manifest.json"
    expected: dict[str, object] = {
        "format": DEPENDENCY_BUNDLE_FORMAT,
        "engine": "tflite",
        "build_type": build_type,
        "linkage": "shared",
        "preset": "android-tflite",
        "target_system": "android",
        "target_architecture": abi,
        "dependency_digest": dependency_bundle_digest("tflite"),
        "toolchain_identity": os.environ.get("SPENCH_TOOLCHAIN_IDENTITY", "local-host"),
        "prefix": str(prefix.relative_to(ROOT)),
    }
    if manifest_path.is_file() and prefix.is_dir():
        try:
            if json.loads(manifest_path.read_text()) == expected:
                print(f"Reusing prebuilt tflite dependency bundle: {artifact_root.relative_to(ROOT)}")
                return prefix
        except json.JSONDecodeError:
            pass

    if host:
        android_ndk = os.environ.get("ANDROID_NDK_HOME")
        if not android_ndk:
            raise SystemExit("ANDROID_NDK_HOME is required for --host Android dependency preparation.")
        source_dir = str(ROOT)
        build_dir = str(ROOT / "out" / "build" / "prebuilt" / "android" / abi / "tflite" / build_type.lower())
        stage = None
    else:
        android_ndk = f"/opt/android-sdk/ndk/{ANDROID_NDK_VERSION}"
        source_dir = "/workspace"
        build_dir = f"/workspace/out/build/prebuilt/android/{abi}/tflite/{build_type.lower()}"
        stage = "android-base"
    environment = compiler_cache_environment(stage is not None)
    with artifact_lock(artifact_root):
        if manifest_path.is_file() and prefix.is_dir():
            try:
                if json.loads(manifest_path.read_text()) == expected:
                    print(f"Reusing prebuilt tflite dependency bundle: {artifact_root.relative_to(ROOT)}")
                    return prefix
            except json.JSONDecodeError:
                pass
        print(f"Preparing tflite {build_type} dependency bundle for android/{abi}.")
        configure_command = [
            "cmake", "-S", source_dir, "-B", build_dir,
            f"-DCMAKE_TOOLCHAIN_FILE={android_ndk}/build/cmake/android.toolchain.cmake",
            f"-DANDROID_ABI={abi}",
            "-DANDROID_PLATFORM=android-26",
            f"-DCMAKE_BUILD_TYPE={build_type}",
            "-DSPENCH_PROFILE=android-tflite",
            "-DBUILD_TFLITE_ENGINE=ON",
            "-DBUILD_ONNX_ENGINE=OFF",
            "-DBUILD_SHARED_LIBS=OFF",
            "-DBUILD_CLI=OFF",
            "-DBUILD_TESTING=OFF",
            "-DSPENCH_ENGINE_BUNDLE_LINKAGE=shared",
        ]
        run(configure_command, container_stage=stage, environment=environment)
        run(["cmake", "--build", build_dir, "--target", "tensorflow-lite", "--parallel", "2"],
            container_stage=stage, environment=environment)
        library = copy_engine_library(prefix, "tflite",
                                      ROOT / "out" / "build" / "prebuilt" / "android" / abi / "tflite" / build_type.lower())
        write_engine_package_config(prefix, "tflite", library, "shared")
        copy_tflite_headers(prefix, ROOT / "out" / "build" / "prebuilt" / "android" / abi /
                            "tflite" / build_type.lower())
        write_dependency_bundle(artifact_root, expected)
        print(f"Prepared dependency bundle: {artifact_root.relative_to(ROOT)}")
        return prefix


def run_web_node(command: list[str], *, container_stage: str | None,
                 environment: dict[str, str], workdir: Path,
                 isolate_node_modules: bool = True) -> None:
    if container_stage is None:
        if not (Path.home() / ".nvm" / "nvm.sh").is_file():
            run(command, workdir=workdir)
            return
        nvm_script = 'source "$HOME/.nvm/nvm.sh"; nvm install; nvm use; exec "$@"'
    else:
        nvm_script = (
            'export NVM_DIR="$HOME/.nvm"; source /usr/local/lib/nvm/nvm.sh; '
            'nvm install; nvm use; exec "$@"'
        )

    run(["bash", "-lc", nvm_script, "bash", *command], container_stage=container_stage,
        environment=environment, workdir=workdir,
        isolate_web_node_modules=container_stage is not None and isolate_node_modules)


def cmake_workflow(action: str, preset: str, host: bool) -> None:
    use_host = host or preset in HOST_ONLY_PRESETS
    stage = None if use_host else PRESET_STAGES[preset]
    build_dir_host = (ROOT / "out" / "build" / preset if use_host else
                      ROOT / "out" / "build" / "container-clang-llvm-tools" / preset)
    build_dir = str(build_dir_host) if use_host else f"/workspace/{build_dir_host.relative_to(ROOT)}"
    environment = compiler_cache_environment(stage is not None)
    if not use_host:
        environment["SPENCH_BUILD_DIR"] = build_dir

    if action == "build":
        prebuilt_prefix = find_prebuilt_dependency(preset, host)
        configure_command = ["cmake", "--preset", preset]
        build_command = ["cmake", "--build", "--preset", preset]
        configure_command.extend(prebuilt_cmake_arguments(
            preset, host, prebuilt_prefix, stage is not None))
        if not use_host:
            configure_command.extend(("-B", build_dir))
            build_command = ["cmake", "--build", build_dir]
        if stage in {"native", "web"} and preset != "native-model-packer":
            configure_command.extend(("-DCMAKE_AR=/usr/bin/llvm-ar",
                                      "-DCMAKE_RANLIB=/usr/bin/llvm-ranlib"))
        run(configure_command, container_stage=stage, environment=environment)
        run(build_command, container_stage=stage, environment=environment)
        print_compiler_cache_stats(stage, environment)
        return

    if not build_dir_host.is_dir():
        raise SystemExit(
            f"Build output for {preset} does not exist at {build_dir_host.relative_to(ROOT)}. "
            f"Run 'tools/spench build {preset}{' --host' if host else ''}' first.")

    if action == "test":
        if preset in NATIVE_PRESETS:
            test_command = ["ctest", "--preset", preset]
            if not use_host:
                test_command = ["ctest", "--test-dir", build_dir, "--output-on-failure"]
            run(test_command, container_stage=stage, environment=environment)
        else:
            run(["bash", "platform_wrappers/web/packages/web-sdk/wasm/scripts/test.sh", preset],
                container_stage=stage, environment=environment)
    elif action == "package":
        if preset not in {"native-release-onnx", "native-release-tflite"}:
            raise SystemExit(f"Packaging is not supported for {preset}.")
        package_dir = ROOT / "out" / "artifacts" / preset
        package_dir.mkdir(parents=True, exist_ok=True)
        package_output_dir = str(package_dir) if stage is None else f"/workspace/out/artifacts/{preset}"
        package_command = ["cpack", "--preset", preset, "-G", "TGZ", "-B", package_output_dir]
        if not use_host:
            package_command = [
                "cpack", "--config", f"{build_dir}/CPackConfig.cmake", "-G", "TGZ",
                "-B", package_output_dir,
            ]
        run(package_command, container_stage=stage, environment=environment)
    elif action == "install":
        install_dir = ROOT / "out" / "artifacts" / "install" / preset
        if install_dir.exists():
            shutil.rmtree(install_dir)
        install_dir.mkdir(parents=True, exist_ok=True)
        prebuilt_prefix = find_prebuilt_dependency(preset, host)
        if prebuilt_prefix is not None:
            # The engine is an implementation dependency, but shared bundles
            # still need its runtime library. Merge the validated dependency
            # prefix so the uploaded install tree is self-contained.
            shutil.copytree(prebuilt_prefix, install_dir, dirs_exist_ok=True)
        configured_build_dir = build_dir_host if stage is None else Path(build_dir)
        install_output = str(install_dir) if stage is None else f"/workspace/{install_dir.relative_to(ROOT)}"
        install_command = ["cmake", "--install", str(configured_build_dir), "--prefix", install_output]
        if preset.startswith(("windows-", "ios-")):
            install_command.extend(("--config", "Debug" if "debug" in preset or "asan" in preset else "Release"))
        run(install_command, container_stage=stage, environment=environment)
        manifest = {
            "format": 1,
            "preset": preset,
            "dependency_bundle": (dependency_tag(preset, host)
                                  if prebuilt_prefix is not None else None),
        }
        (install_dir / "manifest.json").write_text(
            json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        write_artifact_checksums(install_dir)


def android_workflow(action: str, host: bool) -> None:
    stage = None if host else "android"
    script = "test-all.sh" if action == "test" else "build.sh"
    environment = compiler_cache_environment(stage is not None)
    if artifact_version := os.environ.get("SPENCH_ARTIFACT_VERSION"):
        environment["SPENCH_ARTIFACT_VERSION"] = artifact_version
    dependency_root = "/workspace/out/artifacts/dependencies" if not host else str(
        ROOT / "out" / "artifacts" / "dependencies")
    environment["SPENCH_PREBUILT_DEPENDENCIES_ROOT"] = dependency_root
    if not host:
        environment.update({
            "GRADLE_OPTS": (
                "-Dorg.gradle.vfs.watch=false -Dorg.gradle.workers.max=2 "
                "-Dorg.gradle.jvmargs=-Xmx3g"
            ),
        })
    run([f"platform_wrappers/android/scripts/{script}"], container_stage=stage,
        environment=environment)


def ios_workflow(action: str) -> None:
    scripts = {
        "build": "build_xcframework.sh",
        "test": "test.sh",
        "core": "build_core.sh",
    }
    device_root = find_prebuilt_dependency("ios-device-release", True)
    simulator_root = find_prebuilt_dependency("ios-simulator-release", True)
    environment = compiler_cache_environment(False)
    if device_root and simulator_root:
        environment.update({
            "SPENCH_PREBUILT_ORT_DEVICE_ROOT": str(device_root),
            "SPENCH_PREBUILT_ORT_SIMULATOR_ROOT": str(simulator_root),
        })
    run([f"platform_wrappers/ios/scripts/{scripts[action]}"], environment=environment)


def web_workflow(action: str, host: bool) -> None:
    web_dir = ROOT / "platform_wrappers/web"
    environment = compiler_cache_environment(not host)
    if site_base := os.environ.get("SPENCH_SITE_BASE"):
        environment["SPENCH_SITE_BASE"] = site_base

    if action == "test":
        required_outputs = (
            web_dir / "packages/web-sdk/dist",
            web_dir / "packages/web-sdk/generated/wasm",
        )
        missing = [path.relative_to(ROOT) for path in required_outputs if not path.exists()]
        if missing:
            raise SystemExit(
                "Web build output is missing: " + ", ".join(map(str, missing)) +
                ". Run 'tools/spench build web' first.")
        test_stage = None if host else "web"
        run_web_node(["npm", "ci"], container_stage=test_stage,
                     environment=environment, workdir=web_dir)
        run_web_node(["npm", "test", "--workspace=@gigaedge/spench-web-sdk"],
                     container_stage=test_stage, environment=environment, workdir=web_dir)
        return

    if action == "package":
        package_dir = ROOT / "out/artifacts/web"
        package_dir.mkdir(parents=True, exist_ok=True)
        stage = None if host else "web"
        run_web_node([
            "npm", "pack", "--workspace=@gigaedge/spench-web-sdk",
            "--pack-destination", "../../out/artifacts/web",
        ], container_stage=stage, environment=environment, workdir=web_dir)
        return

    if action == "playwright":
        installed_sdk = web_dir / "node_modules/@gigaedge/spench-web-sdk/package.json"
        if not installed_sdk.is_file():
            raise SystemExit(
                "The packed Web SDK is not installed. Install the downloaded package into "
                "@gigaedge/spench-site before running Playwright.")
        stage = None if host else "web"
        run_web_node(["npm", "run", "build", "--workspace=@gigaedge/spench-site"],
                     container_stage=stage, environment={"SPENCH_SITE_BASE": "/"},
                     workdir=web_dir, isolate_node_modules=False)
        run_web_node(["npm", "run", "pw:test", "--workspace=@gigaedge/spench-site"],
                     container_stage=stage,
                     environment={"PLAYWRIGHT_WORKERS": "1"}, workdir=web_dir,
                     isolate_node_modules=False)
        return

    stage = None if host else "web"
    prebuilt_prefix = find_prebuilt_dependency("wasm-release", host)
    build_dir = None if host else "/workspace/out/build/container-clang-llvm-tools/wasm-release"
    if build_dir is not None:
        environment["SPENCH_BUILD_DIR"] = build_dir
    run_web_node(["npm", "ci"], container_stage=stage, environment=environment, workdir=web_dir)
    configure_command = ["cmake", "--preset", "wasm-release"]
    configure_command.extend(prebuilt_cmake_arguments(
        "wasm-release", host, prebuilt_prefix, stage is not None))
    build_command = ["cmake", "--build", "out/build/wasm-release"]
    if build_dir is not None:
        configure_command.extend((
            "-B", build_dir,
            "-DCMAKE_AR=/usr/bin/llvm-ar",
            "-DCMAKE_RANLIB=/usr/bin/llvm-ranlib",
        ))
        build_command = ["cmake", "--build", build_dir]

    run(configure_command, container_stage=stage, environment=environment)
    run(build_command, container_stage=stage, environment=environment)

    dsp_build_dir = None if host else "/workspace/out/build/container-clang-llvm-tools/wasm-dsp-release"
    dsp_environment = compiler_cache_environment(stage is not None)
    if dsp_build_dir is not None:
        dsp_environment["SPENCH_BUILD_DIR"] = dsp_build_dir
    dsp_configure_command = ["cmake", "--preset", "wasm-dsp-release"]
    dsp_build_command = ["cmake", "--build", "out/build/wasm-dsp-release"]
    if dsp_build_dir is not None:
        dsp_configure_command.extend((
            "-B", dsp_build_dir,
            "-DCMAKE_AR=/usr/bin/llvm-ar",
            "-DCMAKE_RANLIB=/usr/bin/llvm-ranlib",
        ))
        dsp_build_command = ["cmake", "--build", dsp_build_dir]

    run(dsp_configure_command, container_stage=stage, environment=dsp_environment)
    run(dsp_build_command, container_stage=stage, environment=dsp_environment)

    stage_environment = {
        "SPENCH_WASM_FULL_BUILD_DIR": build_dir or str(ROOT / "out/build/wasm-release"),
        "SPENCH_WASM_DSP_BUILD_DIR": dsp_build_dir or str(ROOT / "out/build/wasm-dsp-release"),
    }
    run_web_node(["npm", "run", "stage:wasm:release"], container_stage=stage,
                 environment=stage_environment, workdir=web_dir)
    run_web_node(["npm", "run", "build", "--workspace=@gigaedge/spench-web-sdk"], container_stage=stage,
                 environment=environment, workdir=web_dir)
    run_web_node(["npm", "run", "build", "--workspace=@gigaedge/spench-site"],
                 container_stage=stage, environment=environment, workdir=web_dir)


def prepare_platform_dependencies(target: str, host: bool) -> None:
    if target in ANDROID_DEPENDENCY_TARGETS:
        prepare_android_tflite(ANDROID_DEPENDENCY_TARGETS[target], "Release", host)
        return
    if target == "macos":
        for preset in (
                "macos-x86_64-debug-onnx", "macos-x86_64-release-onnx",
                "macos-x86_64-release-static-onnx",
                "macos-x86_64-debug-tflite", "macos-x86_64-release-tflite",
                "macos-arm64-debug-onnx", "macos-arm64-release-onnx",
                "macos-arm64-release-static-onnx",
                "macos-arm64-debug-tflite", "macos-arm64-release-tflite"):
            prepare_dependency(preset, True)
        return
    if target == "windows":
        for preset in ("windows-x64-debug-onnx", "windows-x64-release-onnx",
                       "windows-x64-debug-tflite", "windows-x64-release-tflite",
                       "windows-x64-release-static-tflite"):
            prepare_dependency(preset, True)
        return
    if target == "ios":
        for preset in ("ios-device-debug", "ios-device-release",
                       "ios-simulator-debug", "ios-simulator-release"):
            prepare_dependency(preset, True)
        return
    if target == "web":
        for preset in ("wasm-debug", "wasm-release"):
            prepare_dependency(preset, host)
        return
    if target == "android":
        for abi in ANDROID_ABIS:
            for build_type in ("Debug", "Release"):
                prepare_android_tflite(abi, build_type, host)
        return
    prepare_dependency(target, host)


def prepare_image(target: str) -> None:
    """Prepare dependency bundles, package them in OCI images, and export archives."""
    if target == "native":
        for preset in ("native-debug-onnx", "native-release-onnx",
                       "native-release-static-onnx", "native-debug-tflite",
                       "native-release-tflite", "native-release-static-tflite"):
            prepare_dependency(preset, False)
        stages = ("deps-native",)
    elif target == "wasm":
        for preset in ("wasm-debug", "wasm-release"):
            prepare_dependency(preset, False)
        stages = ("deps-wasm",)
    elif target == "android":
        prepare_platform_dependencies("android", False)
        stages = ("deps-android",)
    elif target == "ios":
        prepare_platform_dependencies("ios", True)
        stages = ("deps-ios",)
    elif target == "macos":
        prepare_platform_dependencies("macos", True)
        stages = ("deps-macos-x86_64", "deps-macos-arm64")
    elif target == "windows":
        prepare_platform_dependencies("windows", True)
        stages = ("deps-windows-x64",)
    else:
        raise SystemExit("prepare-image supports native, wasm, android, ios, macos, or windows.")

    image_directory = ROOT / "out" / "artifacts" / "images"
    image_directory.mkdir(parents=True, exist_ok=True)
    for stage in stages:
        image = ensure_container_image(stage)
        archive = image_directory / f"{image.replace(':', '-').replace('/', '-')}.tar"
        subprocess.run(["docker", "save", "--output", str(archive), image], check=True)
        checksum = hashlib.sha256(archive.read_bytes()).hexdigest()
        archive.with_suffix(archive.suffix + ".sha256").write_text(f"{checksum}  {archive.name}\n")
        print(f"Prepared dependency image artifact: {archive.relative_to(ROOT)}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=(
        "build", "test", "package", "install", "core", "cache-key", "prepare-deps",
        "prepare-image", "image-key", "recipe-key", "dependency-key", "dependency-archive",
        "restore-deps"))
    parser.add_argument(
        "target",
        choices=(*PRESET_STAGES, *HOST_ONLY_PRESETS, *ANDROID_DEPENDENCY_TARGETS,
                 "android", "ios", "web", "web-playwright", "macos", "windows", "native", "wasm"),
        help="CMake preset or platform workflow",
    )
    parser.add_argument("artifact", nargs="?", help="Archive path used by restore-deps.")
    parser.add_argument("--host", action="store_true",
                        help="Use locally installed tools instead of Docker where Docker is the default.")
    args = parser.parse_args()

    if args.action == "image-key":
        if args.target not in {"native", "web", "android"}:
            raise SystemExit("image-key expects native, web, or android.")
        print(container_image_digest(args.target))
        return
    if args.action == "recipe-key":
        # The compiler toolchain identity is Dockerfile-content-derived and shared
        # by every container stage; the target only documents the caller's intent.
        print(recipe_key())
        return
    if args.action == "dependency-key":
        print(dependency_tag(args.target, args.host))
        return
    if args.action == "dependency-archive":
        archive = dependency_archive_for_target(args.target, args.host)
        if not archive.is_file() or not Path(f"{archive}.sha256").is_file():
            raise SystemExit(
                f"Dependency archive for {args.target} is missing. Run prepare-deps first.")
        print(archive)
        return
    if args.action == "restore-deps":
        if not args.artifact:
            raise SystemExit("restore-deps requires an archive path.")
        restore_dependency_bundle(args.target, args.host, Path(args.artifact))
        return
    if args.action == "cache-key":
        print_cache_keys(args.target, args.host)
        return
    if args.action == "prepare-deps":
        if args.target in {"native", "wasm", "web"}:
            raise SystemExit("prepare-deps expects a preset or platform workflow, not a Docker stage.")
        prepare_platform_dependencies(args.target, args.host)
        return
    if args.action == "prepare-image":
        prepare_image(args.target)
        return

    if args.target in PRESET_STAGES or args.target in HOST_ONLY_PRESETS:
        if args.action == "core":
            raise SystemExit("The core action is only valid for the iOS workflow.")
        cmake_workflow(args.action, args.target, args.host)
    elif args.target == "android":
        if args.action not in {"build", "test"}:
            raise SystemExit("Android supports build and test.")
        android_workflow(args.action, args.host)
    elif args.target == "ios":
        if args.action not in {"build", "test", "core"}:
            raise SystemExit("iOS supports build, core, and test.")
        ios_workflow(args.action)
    elif args.target == "web":
        if args.action not in {"build", "test", "package"}:
            raise SystemExit("The web SDK supports build, test, and package.")
        web_workflow(args.action, args.host)
    elif args.target == "web-playwright":
        if args.action != "test":
            raise SystemExit("The Web Playwright target supports test only.")
        web_workflow("playwright", args.host)
    else:
        raise SystemExit(f"{args.target} is only valid with prepare-deps or prepare-image.")


if __name__ == "__main__":
    main()
