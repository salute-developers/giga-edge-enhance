{
  "name": "@gigaedge/denoiser-site",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "start": "npm-run-all -p 'watch:*'",
    "watch:sdk": "npm run start --workspace=@gigaedge/denoiser-web-sdk",
    "prewatch:app": "node scripts/stage-docs.mjs",
    "watch:app": "docusaurus start --port 5173",
    "build": "node scripts/stage-docs.mjs && tsc --noEmit && docusaurus build",
    "test": "npm run pw:test",
    "pw:open": "npx playwright test --ui",
    "pw:test": "playwright test",
    "pw:test:mos-candidates": "MOS_WRITE_CANDIDATES=1 PLAYWRIGHT_WORKERS=1 npm run pw:test",
    "lint": "eslint .",
    "preview": "docusaurus serve --port 5173",
    "serve:test": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@gigaedge/denoiser-web-sdk": "file:../../packages/web-sdk",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "coi-serviceworker": "0.1.7",
    "jstat": "^1.9.6",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.2.0",
    "@types/react": "^19.3",
    "@types/react-dom": "^19.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "5.110.3"
  }
}
