{
  "name": "@gigaedge/denoiser-web-sdk",
  "version": "0.0.1",
  "private": true,
  "author": "Giga Edge",
  "description": "GigaDenoiser Web SDK",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "models",
    "generated/wasm",
    "!**/__spec__/**"
  ],
  "scripts": {
    "prebuild": "npm-run-all clean verify:wasm stage:license",
    "prepack": "node scripts/stage-wasm.mjs --verify release && npm run build",
    "build": "npm-run-all inject-version -p 'build:*'",
    "build:webpack": "webpack --mode=production",
    "build:tsc": "tsc -p tsconfig.build.json",
    "start": "npm-run-all inject-version -p 'watch:*'",
    "watch:webpack": "webpack --watch",
    "watch:tsc": "tsc -w -p tsconfig.build.json",
    "inject-version": "node -p \"'export const LIB_VERSION = \\'' + require('./package.json').version + (process.env.CI ? '' : '-dev') + '\\';'\" > src/utils/version.ts",
    "clean": "rm -rf dist",
    "verify:wasm": "node scripts/stage-wasm.mjs --verify",
    "stage:license": "node scripts/stage-license.mjs",
    "test": "jest --ci --runInBand --detectOpenHandles --logHeapUsage",
    "lint": "eslint .",
    "lint:eslint:fix": "eslint --fix",
    "lint:eslint": "eslint"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/preset-typescript": "7.24.7",
    "@swc/core": "1.7.2",
    "@types/audioworklet": "0.0.60",
    "@types/jest": "30.0.0",
    "@typescript-eslint/eslint-plugin": "8.6.0",
    "@typescript-eslint/parser": "8.6.0",
    "babel-loader": "9.1.3",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.30.0",
    "eslint-plugin-jest": "28.8.3",
    "eslint-plugin-jsx-a11y": "6.10.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "npm-run-all": "4.1.5",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "webpack": "5.104.1",
    "webpack-cli": "5.1.4"
  },
  "dependencies": {
    "serialize-error": "12.0.0"
  }
}
