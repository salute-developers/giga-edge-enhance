{
  "name": "Spench Native",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "native"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=spench-cpm,target=/workspaces/${localWorkspaceFolderBasename}/out/cache/cpm,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ]
    }
  }
}
