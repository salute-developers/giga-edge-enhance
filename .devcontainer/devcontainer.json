{
  "name": "GigaDenoiser Native",
  "build": {
    "dockerfile": "../dockerfiles/Dockerfile.base",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=giga-denoiser-cpm,target=/workspaces/${localWorkspaceFolderBasename}/out/cache/cpm,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ]
    }
  }
}
