@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@_gee_config_static@)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

if(@_gee_config_static@)
  file(GLOB_RECURSE _enhance_static_archives
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/enhance/deps/*@CMAKE_STATIC_LIBRARY_SUFFIX@")
  if(NOT _enhance_static_archives)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "The static GigaEdgeEnhance package contains no dependency archives.")
    return()
  endif()

  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_enhance_static_link_libraries "-Wl,--start-group;${_enhance_static_archives};-Wl,--end-group")
  else()
    set(_enhance_static_link_libraries "${_enhance_static_archives};${_enhance_static_archives}")
  endif()
  set(_enhance_system_link_libraries Threads::Threads)
  if(UNIX)
    list(APPEND _enhance_system_link_libraries ${CMAKE_DL_LIBS} m)
  endif()
  if(APPLE)
    # Static ONNX/Abseil objects use NSLog and Core Foundation time-zone APIs.
    list(APPEND _enhance_system_link_libraries "-framework Foundation" "-framework CoreFoundation")
  endif()
  set_property(TARGET giga-edge::enhance APPEND PROPERTY INTERFACE_LINK_LIBRARIES
    "${_enhance_static_link_libraries};${_enhance_system_link_libraries}")
endif()

check_required_components(@PROJECT_NAME@)
