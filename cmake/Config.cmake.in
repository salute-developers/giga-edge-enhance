@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@_spench_config_static@)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

if(@_spench_config_static@)
  file(GLOB_RECURSE _spench_static_archives
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/spench/deps/*@CMAKE_STATIC_LIBRARY_SUFFIX@")
  if(NOT _spench_static_archives)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "The static GigaEdgeSpench package contains no dependency archives.")
    return()
  endif()

  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_spench_static_link_libraries "-Wl,--start-group;${_spench_static_archives};-Wl,--end-group")
  else()
    set(_spench_static_link_libraries "${_spench_static_archives};${_spench_static_archives}")
  endif()
  set(_spench_system_link_libraries Threads::Threads)
  if(UNIX)
    list(APPEND _spench_system_link_libraries ${CMAKE_DL_LIBS} m)
  endif()
  set_property(TARGET @PROJECT_NAME@::@PROJECT_NAME@ APPEND PROPERTY INTERFACE_LINK_LIBRARIES
    "${_spench_static_link_libraries};${_spench_system_link_libraries}")
endif()

check_required_components(@PROJECT_NAME@)
