set(SPENCH_PROFILE "" CACHE STRING "Supported product profile")
set_property(CACHE SPENCH_PROFILE PROPERTY STRINGS "" native model-packer wasm ios android-tflite)

function(_spench_profile_requires variable expected)
  if(NOT ${variable} STREQUAL ${expected})
    message(FATAL_ERROR
      "SPENCH_PROFILE=${SPENCH_PROFILE} requires ${variable}=${expected}; got '${${variable}}'.")
  endif()
endfunction()

if(SPENCH_PROFILE STREQUAL "native")
  if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "SPENCH_PROFILE=native cannot target ${CMAKE_SYSTEM_NAME}.")
  endif()
elseif(SPENCH_PROFILE STREQUAL "wasm")
  if(NOT EMSCRIPTEN)
    message(FATAL_ERROR "SPENCH_PROFILE=wasm requires the Emscripten toolchain.")
  endif()
  if(BUILD_DSP)
    _spench_profile_requires(BUILD_ONNX_ENGINE OFF)
  else()
    _spench_profile_requires(BUILD_ONNX_ENGINE ON)
  endif()
  _spench_profile_requires(BUILD_TFLITE_ENGINE OFF)
elseif(SPENCH_PROFILE STREQUAL "model-packer")
  if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "SPENCH_PROFILE=model-packer requires a native toolchain.")
  endif()
  _spench_profile_requires(BUILD_ONNX_ENGINE OFF)
  _spench_profile_requires(BUILD_TFLITE_ENGINE OFF)
elseif(SPENCH_PROFILE STREQUAL "ios")
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "SPENCH_PROFILE=ios requires the iOS CMake toolchain.")
  endif()
  _spench_profile_requires(BUILD_ONNX_ENGINE ON)
  _spench_profile_requires(BUILD_TFLITE_ENGINE OFF)
  _spench_profile_requires(BUILD_SHARED_LIBS OFF)
elseif(SPENCH_PROFILE STREQUAL "android-tflite")
  if(NOT ANDROID)
    message(FATAL_ERROR "SPENCH_PROFILE=android-tflite requires the Android NDK toolchain.")
  endif()
  _spench_profile_requires(BUILD_ONNX_ENGINE OFF)
  _spench_profile_requires(BUILD_TFLITE_ENGINE ON)
elseif(NOT SPENCH_PROFILE STREQUAL "")
  message(FATAL_ERROR "Unknown SPENCH_PROFILE='${SPENCH_PROFILE}'.")
endif()
