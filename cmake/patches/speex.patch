diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..a185db5
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,61 @@
+cmake_minimum_required(VERSION 3.15)
+
+project(speexdsp_spench LANGUAGES C)
+
+set(CMAKE_C_STANDARD 99)
+
+set(SPEEX_FFT "EXTFFT" CACHE STRING "fft backend type [KISSFFT, SMALLFT, EXTFFT]")
+
+set(SPEEX_SOURCES
+    libspeexdsp/buffer.c 
+    libspeexdsp/filterbank.c 
+    libspeexdsp/jitter.c 
+    libspeexdsp/mdf.c 
+    libspeexdsp/preprocess.c 
+    libspeexdsp/resample.c 
+    libspeexdsp/scal.c
+)
+
+set(INCLUDE_STDINT "#include <stdint.h>")
+set(SIZE16 "int16_t")
+set(USIZE16 "uint16_t")
+set(SIZE32 "int32_t")
+set(USIZE32 "uint32_t")
+configure_file(include/speex/speexdsp_config_types.h.in ${CMAKE_BINARY_DIR}/speex/speexdsp_config_types.h)
+
+set(SPEEX_DEFINES 
+    "FLOATING_POINT=1"
+    "EXPORT="
+)
+
+if (SPEEX_FFT STREQUAL "KISSFFT")
+    message(STATUS "Speex FFT: `kissfft`")
+    list(APPEND SPEEX_SOURCES 
+        libspeexdsp/kiss_fft.c 
+        libspeexdsp/kiss_fftr.c 
+        libspeexdsp/fftwrap.c 
+    )
+    list(APPEND SPEEX_DEFINES "USE_KISS_FFT=1")
+elseif(SPEEX_FFT STREQUAL "SMALLFT")
+    message(STATUS "Speex FFT: `smallft`")
+    list(APPEND SPEEX_SOURCES 
+        libspeexdsp/smallft.c
+        libspeexdsp/fftwrap.c 
+    )
+    list(APPEND SPEEX_DEFINES "USE_SMALLFT=1")
+elseif(SPEEX_FFT STREQUAL "EXTFFT")
+    message(STATUS "Speex FFT: custom spx_fft* implementation")
+endif()
+
+add_library(${PROJECT_NAME} STATIC ${SPEEX_SOURCES})
+
+target_include_directories(${PROJECT_NAME} 
+    PUBLIC include
+    PUBLIC ${CMAKE_BINARY_DIR}/speex
+    PRIVATE include/speex
+    PRIVATE libspeexdsp
+)
+
+target_compile_definitions(${PROJECT_NAME} 
+    PRIVATE ${SPEEX_DEFINES}
+)
\ No newline at end of file
