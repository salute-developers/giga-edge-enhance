set(GES_PROFILE "" CACHE STRING "Supported product profile")
set_property(CACHE GES_PROFILE PROPERTY STRINGS "" native model-packer wasm ios android-tflite)

function(_ges_profile_requires variable expected)
  if(NOT ${variable} STREQUAL ${expected})
    message(FATAL_ERROR
      "GES_PROFILE=${GES_PROFILE} requires ${variable}=${expected}; got '${${variable}}'.")
  endif()
endfunction()

if(GES_PROFILE STREQUAL "native")
  if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GES_PROFILE=native cannot target ${CMAKE_SYSTEM_NAME}.")
  endif()
elseif(GES_PROFILE STREQUAL "wasm")
  if(NOT EMSCRIPTEN)
    message(FATAL_ERROR "GES_PROFILE=wasm requires the Emscripten toolchain.")
  endif()
  if(BUILD_DSP)
    _ges_profile_requires(BUILD_ONNX_ENGINE OFF)
  else()
    _ges_profile_requires(BUILD_ONNX_ENGINE ON)
  endif()
  _ges_profile_requires(BUILD_TFLITE_ENGINE OFF)
elseif(GES_PROFILE STREQUAL "model-packer")
  if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GES_PROFILE=model-packer requires a native toolchain.")
  endif()
  _ges_profile_requires(BUILD_ONNX_ENGINE OFF)
  _ges_profile_requires(BUILD_TFLITE_ENGINE OFF)
elseif(GES_PROFILE STREQUAL "ios")
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GES_PROFILE=ios requires the iOS CMake toolchain.")
  endif()
  _ges_profile_requires(BUILD_ONNX_ENGINE ON)
  _ges_profile_requires(BUILD_TFLITE_ENGINE OFF)
  _ges_profile_requires(BUILD_SHARED_LIBS OFF)
elseif(GES_PROFILE STREQUAL "android-tflite")
  if(NOT ANDROID)
    message(FATAL_ERROR "GES_PROFILE=android-tflite requires the Android NDK toolchain.")
  endif()
  _ges_profile_requires(BUILD_ONNX_ENGINE OFF)
  _ges_profile_requires(BUILD_TFLITE_ENGINE ON)
elseif(NOT GES_PROFILE STREQUAL "")
  message(FATAL_ERROR "Unknown GES_PROFILE='${GES_PROFILE}'.")
endif()
