set(GEE_PROFILE "" CACHE STRING "Supported product profile")
set_property(CACHE GEE_PROFILE PROPERTY STRINGS "" native model-packer wasm ios android-tflite)

function(_gee_profile_requires variable expected)
  if(NOT ${variable} STREQUAL ${expected})
    message(FATAL_ERROR
      "GEE_PROFILE=${GEE_PROFILE} requires ${variable}=${expected}; got '${${variable}}'.")
  endif()
endfunction()

if(GEE_PROFILE STREQUAL "native")
  if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GEE_PROFILE=native cannot target ${CMAKE_SYSTEM_NAME}.")
  endif()
elseif(GEE_PROFILE STREQUAL "wasm")
  if(NOT EMSCRIPTEN)
    message(FATAL_ERROR "GEE_PROFILE=wasm requires the Emscripten toolchain.")
  endif()
  if(BUILD_DSP)
    _gee_profile_requires(BUILD_ONNX_ENGINE OFF)
  else()
    _gee_profile_requires(BUILD_ONNX_ENGINE ON)
  endif()
  _gee_profile_requires(BUILD_TFLITE_ENGINE OFF)
elseif(GEE_PROFILE STREQUAL "model-packer")
  if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GEE_PROFILE=model-packer requires a native toolchain.")
  endif()
  _gee_profile_requires(BUILD_ONNX_ENGINE OFF)
  _gee_profile_requires(BUILD_TFLITE_ENGINE OFF)
elseif(GEE_PROFILE STREQUAL "ios")
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GEE_PROFILE=ios requires the iOS CMake toolchain.")
  endif()
  _gee_profile_requires(BUILD_ONNX_ENGINE ON)
  _gee_profile_requires(BUILD_TFLITE_ENGINE OFF)
  _gee_profile_requires(BUILD_SHARED_LIBS OFF)
elseif(GEE_PROFILE STREQUAL "android-tflite")
  if(NOT ANDROID)
    message(FATAL_ERROR "GEE_PROFILE=android-tflite requires the Android NDK toolchain.")
  endif()
  _gee_profile_requires(BUILD_ONNX_ENGINE OFF)
  _gee_profile_requires(BUILD_TFLITE_ENGINE ON)
elseif(NOT GEE_PROFILE STREQUAL "")
  message(FATAL_ERROR "Unknown GEE_PROFILE='${GEE_PROFILE}'.")
endif()
