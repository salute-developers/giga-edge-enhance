set(GDN_PROFILE "" CACHE STRING "Supported product profile")
set_property(CACHE GDN_PROFILE PROPERTY STRINGS "" native model-packer wasm ios android-tflite)

function(_gdn_profile_requires variable expected)
  if(NOT ${variable} STREQUAL ${expected})
    message(FATAL_ERROR
      "GDN_PROFILE=${GDN_PROFILE} requires ${variable}=${expected}; got '${${variable}}'.")
  endif()
endfunction()

if(GDN_PROFILE STREQUAL "native")
  if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GDN_PROFILE=native cannot target ${CMAKE_SYSTEM_NAME}.")
  endif()
elseif(GDN_PROFILE STREQUAL "wasm")
  if(NOT EMSCRIPTEN)
    message(FATAL_ERROR "GDN_PROFILE=wasm requires the Emscripten toolchain.")
  endif()
  if(BUILD_DSP)
    _gdn_profile_requires(BUILD_ONNX_ENGINE OFF)
  else()
    _gdn_profile_requires(BUILD_ONNX_ENGINE ON)
  endif()
  _gdn_profile_requires(BUILD_TFLITE_ENGINE OFF)
elseif(GDN_PROFILE STREQUAL "model-packer")
  if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GDN_PROFILE=model-packer requires a native toolchain.")
  endif()
  _gdn_profile_requires(BUILD_ONNX_ENGINE OFF)
  _gdn_profile_requires(BUILD_TFLITE_ENGINE OFF)
elseif(GDN_PROFILE STREQUAL "ios")
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "GDN_PROFILE=ios requires the iOS CMake toolchain.")
  endif()
  _gdn_profile_requires(BUILD_ONNX_ENGINE ON)
  _gdn_profile_requires(BUILD_TFLITE_ENGINE OFF)
  _gdn_profile_requires(BUILD_SHARED_LIBS OFF)
elseif(GDN_PROFILE STREQUAL "android-tflite")
  if(NOT ANDROID)
    message(FATAL_ERROR "GDN_PROFILE=android-tflite requires the Android NDK toolchain.")
  endif()
  _gdn_profile_requires(BUILD_ONNX_ENGINE OFF)
  _gdn_profile_requires(BUILD_TFLITE_ENGINE ON)
elseif(NOT GDN_PROFILE STREQUAL "")
  message(FATAL_ERROR "Unknown GDN_PROFILE='${GDN_PROFILE}'.")
endif()
